# ---- Supabase (accounts, products, reviews, uploads) ----
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Publishable key (sb_publishable_…). Older projects: put the anon key in NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never put the service_role / secret key in a NEXT_PUBLIC_ variable. This code does not need it.

# Your domain, used in the sitemap
NEXT_PUBLIC_SITE_URL=https://asiangemstone.vercel.app

# ---- AI writer (choose one; server-only, never NEXT_PUBLIC_) ----
# Claude:
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5        (optional; this is the default)
# OpenAI:
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# AI_MODEL=                         (required: the OpenAI model you want to pay for)

# ---- Photo-to-3D for rings and carvings (optional; server-only) ----
# MESHY_API_KEY=
